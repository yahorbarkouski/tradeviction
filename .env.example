# Copy to .env.local. Only DATABASE_URL and SESSION_SECRET are required.

# Postgres. `npm run dev` starts this one with docker compose. In production
# point it at Neon (or any Postgres); a non-local host gets sslmode=require.
DATABASE_URL=postgres://tradeviction:tradeviction@127.0.0.1:5432/tradeviction

# Signs the session cookie. At least 16 characters; production refuses to
# start without it. Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Cloudflare Turnstile on sign-up and login. Leave empty to skip the
# bot check locally; production refuses sign-ups without both keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Hostnames Turnstile may answer for, comma separated. VERCEL_PROJECT_PRODUCTION_URL is added automatically.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Optional. OpenAI moderation on every public text (usernames, takes, replies,
# listings). Empty means no check locally; production refuses writes without it.
OPENAI_API_KEY=

# Optional. twitterapi.io key for linking a checkmarked X account to a profile.
TWITTERIO_API_KEY=

# Optional. Bearer token that GET /api/ingest expects; the route re-seeds the
# catalog. Production refuses the route without it.
CRON_SECRET=
